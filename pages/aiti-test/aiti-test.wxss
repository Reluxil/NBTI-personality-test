.container {
  padding: 30rpx 30rpx 60rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(180deg, #fdf5fa 0%, #f5f3ff 40%, #eef4ff 100%);
}

/* 进度条 */
.progress-bar {
  height: 12rpx;
  background: rgba(200, 200, 220, 0.35);
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #d4a5ff 0%, #ffb3d9 35%, #7ec8ff 100%);
  border-radius: 6rpx;
  transition: width 0.4s ease;
}
.progress-text {
  text-align: center;
  font-size: 24rpx;
  color: #888;
  margin-bottom: 36rpx;
}

/* 题卡 */
.question-card {
  background: rgba(255, 255, 255, 0.85);
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  box-shadow: 0 4rpx 24rpx rgba(150, 130, 200, 0.08);
}
.question-text {
  font-size: 32rpx;
  line-height: 1.6;
  color: #1a1a2e;
  font-weight: 600;
  margin-bottom: 36rpx;
}

/* A/B 并排卡片 */
.ab-cards {
  display: flex;
  gap: 20rpx;
  margin-bottom: 60rpx;
}
.ab-card {
  flex: 1;
  background: #fff;
  border: 2rpx solid #e0e0ec;
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: all 0.2s ease;
  min-height: 100rpx;
}
.ab-card.selected {
  border-color: #b08aff;
  background: #f5f0ff;
  box-shadow: 0 0 0 2rpx rgba(176, 138, 255, 0.15);
}
.ab-card-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.5;
  color: #333;
}
.ab-badge {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  color: #fff;
  font-weight: bold;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin: 0 0 0 14rpx;
  border: 2rpx solid;
}
.ab-card:first-child .ab-badge { margin: 0 0 0 14rpx; }
.ab-card:last-child .ab-badge { margin: 0 14rpx 0 0; }
.ab-badge-a {
  background: #fff;
  color: #b08aff;
  border-color: #b08aff;
}
.ab-badge-b {
  background: #fff;
  color: #b08aff;
  border-color: #b08aff;
}
.ab-card.selected .ab-badge-a,
.ab-card.selected .ab-badge-b {
  background: #b08aff;
  color: #fff;
}

/* 5 圆 Likert */
.likert-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 40rpx;
  padding: 0 10rpx;
}
.likert-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}
.likert-circle {
  border-radius: 50%;
  background: #fff;
  border: 2rpx solid #c5b3ff;
  margin-bottom: 14rpx;
  transition: all 0.2s ease;
  box-sizing: border-box;
}
.likert-circle.size-lg { width: 60rpx; height: 60rpx; }
.likert-circle.size-md { width: 44rpx; height: 44rpx; margin-top: 8rpx; }
.likert-circle.size-sm { width: 28rpx; height: 28rpx; margin-top: 16rpx; }
.likert-circle.selected {
  background: #b08aff;
  border-color: #b08aff;
  box-shadow: 0 0 0 6rpx rgba(176, 138, 255, 0.15);
}
.likert-label {
  font-size: 22rpx;
  color: #888;
  text-align: center;
  line-height: 1.3;
}

/* 没有相似经验 */
.na-pill {
  display: block;
  width: fit-content;
  margin: 0 auto 50rpx;
  padding: 14rpx 36rpx;
  background: #fff;
  border: 2rpx solid #e0d6f5;
  border-radius: 40rpx;
  font-size: 24rpx;
  color: #888;
  text-align: center;
}
.na-pill-wrap {
  text-align: center;
  margin-bottom: 50rpx;
}
.na-pill.selected {
  background: #f5f0ff;
  border-color: #b08aff;
  color: #7c4dff;
}

/* 底部导航 */
.nav-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}
.btn-prev,
.btn-next-2 {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}
.btn-prev {
  background: #fff;
  border: 2rpx solid #e0d6f5;
  color: #7c4dff;
}
.btn-prev.disabled {
  color: #ccc;
  border-color: #f0f0f0;
  background: #fafafa;
}
.btn-next-2 {
  background: linear-gradient(135deg, #c8a8ff 0%, #a78bfa 100%);
  color: #fff;
}
.btn-next-2.disabled {
  background: #e0e0e8;
  color: #fff;
}

/* 场景题 */
.scene {
  background: #faf8ff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.scene-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #7c4dff;
  margin-bottom: 8rpx;
}
.scene-prompt {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 18rpx;
}
.scene-opts {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.opt {
  background: #fff;
  border: 2rpx solid #e0d6f5;
  border-radius: 14rpx;
  padding: 22rpx 24rpx;
  font-size: 27rpx;
  line-height: 1.5;
  color: #333;
}
.opt.selected {
  background: #f5f0ff;
  border-color: #b08aff;
  color: #7c4dff;
  font-weight: 600;
}
.factor-prompt {
  font-size: 28rpx;
  font-weight: bold;
  color: #1a1a2e;
  margin: 10rpx 0 16rpx;
}
.factor-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.factor {
  border-style: dashed;
  border-color: #d4baff;
}
.factor.selected {
  background: #f5f0ff;
  border-color: #b08aff;
  color: #7c4dff;
}

/* 加载 */
.loading-section {
  text-align: center;
  padding-top: 160rpx;
}
.loading-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
  animation: spin 2s linear infinite;
}
@keyframes spin { 0% { transform: rotate(0); } 100% { transform: rotate(360deg); } }
.loading-text {
  font-size: 34rpx;
  font-weight: bold;
  color: #1a1a2e;
  margin-bottom: 12rpx;
}
.loading-subtext {
  font-size: 26rpx;
  color: #888;
}
